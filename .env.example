# --- Servidor ---
PORT=3002
PUBLIC_URL=https://elmundodelise.com
UPLOAD_DIR=/var/www/elmundodelise/uploads

# --- Base de datos (Supabase → Connect → connection string) ---
# Postgres directo. No se usan claves de API ni Supabase Auth: usuarios y sesiones son propios.
DATABASE_URL=postgresql://postgres.XXXX:CONTRASEÑA@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# --- PayPal (developer.paypal.com → Apps & Credentials) ---
PAYPAL_MODE=sandbox                 # sandbox para pruebas, live en producción
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Bizum (pago manual: el cliente envía Bizum y tú lo confirmas en el backoffice) ---
BIZUM_PHONE=

# --- Envío, en euros (pendiente de contratar transportista). Moneda de la tienda: EUR ---
SHIPPING_EUR=0                      # coste fijo del envío, p. ej. 4,95
FREE_SHIPPING_FROM_EUR=0            # envío gratis a partir de este importe, p. ej. 50; 0 = desactivado

# --- Correo (opcional): activa «¿Has olvidado la contraseña?» ---
SMTP_HOST=                          # p. ej. smtp.ionos.es
SMTP_PORT=465
SMTP_USER=                          # p. ej. hola@elmundodelise.com
SMTP_PASS=
SMTP_FROM=                          # p. ej. "El mundo de Lise <hola@elmundodelise.com>"
