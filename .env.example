# --- Servidor ---
PORT=3002
UPLOAD_DIR=/var/www/elmundodelise/uploads

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_ANON_KEY=eyJ...            # clave "anon public"
SUPABASE_SERVICE_ROLE_KEY=eyJ...    # clave "service_role" (¡secreta, solo en el servidor!)

# --- PayPal (developer.paypal.com → Apps & Credentials) ---
PAYPAL_MODE=sandbox                 # sandbox para pruebas, live en producción
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Bizum (pago manual: el cliente envía Bizum y tú lo confirmas en el backoffice) ---
BIZUM_PHONE=600 000 000

# --- Envío (en céntimos; pendiente de contratar transportista) ---
SHIPPING_CENTS=0                    # p. ej. 495 = 4,95 €
FREE_SHIPPING_FROM_CENTS=0          # p. ej. 5000 = gratis a partir de 50 €; 0 = desactivado
